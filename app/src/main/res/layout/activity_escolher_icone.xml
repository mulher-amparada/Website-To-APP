<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="34dp"
        android:paddingEnd="22dp"
        android:paddingBottom="48dp">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalização"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:letterSpacing="-0.035" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Escolha o visual que representa seu aplicativo."
            android:textColor="#777777"
            android:textSize="14sp"
            android:fontFamily="sans" />


        <!-- =====================================================
             TÍTULO DAS OPÇÕES
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Escolha seu ícone"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 opções"
                android:textColor="#666666"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- =====================================================
             GRADE
        ====================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- LINHA 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ORIGINAL -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Ícone original"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Original"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIconeOriginal"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="0dp"
                        android:text="Usar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- ÍCONE 1 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icone1"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Ícone 1"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ícone 1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIcone1"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="0dp"
                        android:text="Usar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- LINHA 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- ÍCONE 2 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icone2"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Ícone 2"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ícone 2"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIcone2"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="0dp"
                        android:text="Usar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- ÍCONE 3 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icone3"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Ícone 3"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ícone 3"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIcone3"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="0dp"
                        android:text="Usar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- LINHA 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <!-- ÍCONE 4 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/icone4"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Ícone 4"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ícone 4"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnIcone4"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="0dp"
                        android:text="Usar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <!-- ESPAÇO VISUAL -->

                <View
                    android:layout_width="0dp"
                    android:layout_height="210dp"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- =====================================================
             RODAPÉ
        ====================================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="A alteração será aplicada ao ícone exibido na tela inicial."
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>