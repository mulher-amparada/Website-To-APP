<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arquivos"
                            android:textColor="#111318"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"/>

                        <TextView
                            android:id="@+id/pathText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="/storage"
                            android:textColor="#747986"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/menuBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/file_icon_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="13dp"
                        android:src="@drawable/ic_more"
                        android:tint="#20232A"/>

                </LinearLayout>

                <!-- SEARCH -->
                <LinearLayout
                    android:id="@+id/searchBox"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/search_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        android:tint="#777D89"/>

                    <TextView
                        android:id="@+id/searchHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Pesquisar arquivos"
                        android:textColor="#777D89"
                        android:textSize="15sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- CATEGORIAS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="112dp"
                        android:layout_height="92dp"
                        android:background="@drawable/category_blue"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_folder"
                            android:tint="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pastas"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="112dp"
                        android:layout_height="92dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/category_neutral"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_image"
                            android:tint="#30343D"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Imagens"
                            android:textColor="#30343D"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="112dp"
                        android:layout_height="92dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/category_neutral"
                        android:gravity="bottom"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_document"
                            android:tint="#30343D"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Documentos"
                            android:textColor="#30343D"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- RECENTES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arquivos"
                        android:textColor="#17191E"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/viewMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recentes"
                        android:textColor="#5D6FCA"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- LISTA REAL -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- NOVO ARQUIVO -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/createButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="Novo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:icon="@drawable/ic_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#17191E"
        app:elevation="8dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>