<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090C"
    android:fitsSystemWindows="true">

    <!-- Conteúdo -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/pathContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Barra superior flutuante -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/topbar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Voltar -->
        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/icon_button_background"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_back"
            android:tint="#E8EAF0" />

        <!-- Avançar -->
        <ImageView
            android:id="@+id/ic_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_button_background"
            android:clickable="true"
            android:contentDescription="Avançar"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_forward"
            android:tint="#E8EAF0" />

        <!-- Espaço -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Pesquisar -->
        <ImageView
            android:id="@+id/searchBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_button_background"
            android:clickable="true"
            android:contentDescription="Pesquisar"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_search"
            android:tint="#E8EAF0" />

        <!-- Menu -->
        <ImageView
            android:id="@+id/menuBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/icon_button_background"
            android:clickable="true"
            android:contentDescription="Mais opções"
            android:focusable="true"
            android:padding="13dp"
            android:src="@drawable/ic_more"
            android:tint="#E8EAF0" />

    </LinearLayout>


    <!-- Caminho -->
    <LinearLayout
        android:id="@+id/pathContainer"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Indicador -->
        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/path_indicator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL"
                android:textColor="#6F7480"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="sans"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/pathText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="/storage"
                android:textColor="#F1F2F5"
                android:textSize="16sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>